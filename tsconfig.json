{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "useDefineForClassFields": false,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "config/**/*.ts",
    "playwright.config.ts",
    "playwright.*.config.ts"
  ],
  "exclude": ["node_modules", ".features-gen"]
}

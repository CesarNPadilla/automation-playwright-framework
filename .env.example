# Target environment: dev | qa | staging | prod
ENV=dev

# Base URLs for each environment (HTTPS required, no embedded credentials)
DEV_BASE_URL=https://your-dev-instance.example.com
QA_BASE_URL=
STAGING_BASE_URL=
PROD_BASE_URL=

# Fallback credentials (used when no environment-specific pair is set)
APP_USERNAME=
APP_PASSWORD=

# Environment-specific credential pairs (override the fallback above)
# DEV_APP_USERNAME=
# DEV_APP_PASSWORD=
# QA_APP_USERNAME=
# QA_APP_PASSWORD=

# Run browsers in headless mode (set to "false" for headed local runs)
HEADLESS=true

# --- CI / AWS Secrets Manager (uncomment in GitLab CI pipeline) ---
# AWS_DEFAULT_REGION=us-east-1
# AWS_SECRET_NAME=your/secret/name
